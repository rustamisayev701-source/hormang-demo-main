# Copy to .env and fill in real values.

PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/hormang
VITE_API_URL=http://localhost:3000/api

# Set in production; falls back to an insecure dev default otherwise.
JWT_SECRET=

# Used to build Payme's return-to-app URL and its checkout redirect.
APP_BASE_URL=http://localhost:5173

# ─── Eskiz SMS (notify.eskiz.uz) ───────────────────────────────────────────
# Leave unset in dev to keep using the devCode fallback in the /auth/sms/send response.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender nickname assigned by Eskiz; defaults to "4546" (their shared test sender) if unset.
ESKIZ_FROM=
# Must match a template already approved in the Eskiz dashboard. Use {code} as the placeholder.
ESKIZ_OTP_TEMPLATE=

# ─── Payme (Merchant API) ──────────────────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_KEY=
# "test" (checkout.test.paycom.uz) or "prod" (checkout.paycom.uz). Defaults to test.
PAYME_ENV=test

# ─── Telegram bot ───────────────────────────────────────────────────────────
# Leave unset to disable the bot entirely (no polling, no low-balance reminders).
TELEGRAM_BOT_TOKEN=
